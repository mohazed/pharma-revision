  },
  {
    "id": "chimie-analytique/03-extractions-repetees/flash-007",
    "recto": "ρ (cas général)",
    "verso": "ρ = 1 − 1/[(1+α1)…(1+αn)].",
    "tags": []
  },
  {
    "id": "chimie-analytique/03-extractions-repetees/flash-008",
    "recto": "ρ (volumes égaux)",
    "verso": "ρ = 1 − 1/(1+α)ⁿ = 1 − 1/(1 + λVB/VA)ⁿ.",
    "tags": []
  },
  {
    "id": "chimie-analytique/03-extractions-repetees/flash-009",
    "recto": "ρ en présence de plusieurs formes",
    "verso": "ρ = 1 − 1/(1 + D·VB/VA)ⁿ.",
    "tags": []
  },
  {
    "id": "chimie-analytique/03-extractions-repetees/flash-010",
    "recto": "Pourquoi ρ croît avec n ?",
    "verso": "Car 1 + λVB/VA > 1 : sa puissance n croît et son inverse diminue.",
    "tags": []
  },
  {
    "id": "chimie-analytique/03-extractions-repetees/flash-011",
    "recto": "Exemple pénicilline à 3 étages",
