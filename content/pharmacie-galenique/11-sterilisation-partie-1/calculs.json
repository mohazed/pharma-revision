[
  {
    "id": "pharmacie-galenique/11-sterilisation-partie-1/calcul-001",
    "titre": "Durée de stérilisation pour atteindre le NAS",
    "enonce": "Une charge contient 10^{n0} spores par unité (D121 = {d} min). Quelle durée à 121 °C faut-il pour atteindre un NAS de 10^-{nas} ?",
    "variables": {
      "n0": {
        "min": 2,
        "max": 7,
        "pas": 1,
        "unite": ""
      },
      "d": {
        "min": 0.5,
        "max": 3,
        "pas": 0.5,
        "unite": "min"
      },
      "nas": {
        "min": 6,
        "max": 6,
        "pas": 1,
        "unite": ""
      }
    },
    "formule": "(n0 + nas) * d",
    "unite": "min",
    "decimales": 1,
    "etapes": [
      "Nombre de réductions décimales = log N0 − log N = n0 − (−nas) = n0 + nas",
      "Durée = nombre de réductions × D"
    ],
    "rappel": "log N = log N0 − t/D ; NAS = 10⁻⁶ en stérilisation terminale."
  },
  {
    "id": "pharmacie-galenique/11-sterilisation-partie-1/calcul-002",
    "titre": "Valeur stérilisatrice FT",
    "enonce": "Un produit est chauffé {t} min à {temp} °C (z = {z} °C). Calculez la valeur stérilisatrice équivalente à 121 °C.",
    "variables": {
      "t": {
        "min": 2,
        "max": 30,
        "pas": 1,
        "unite": "min"
      },
      "temp": {
        "min": 105,
        "max": 135,
        "pas": 1,
        "unite": "°C"
      },
      "z": {
        "min": 10,
        "max": 10,
        "pas": 1,
        "unite": "°C"
      }
    },
    "formule": "t * Math.pow(10, (temp - 121) / z)",
    "unite": "min",
    "decimales": 2,
    "etapes": [
      "Calculer l'exposant (T − 121) / z",
      "Calculer 10 à cette puissance",
      "Multiplier par la durée t",
      "Comparer à F0 = 8 min"
    ],
    "rappel": "FT = t × 10^((T − 121)/z) ; F0 minimal = 8 min."
  },
  {
