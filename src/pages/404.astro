---
import Base from "../layouts/Base.astro";
---
<Base titre="Page introuvable" description="Cette page n'existe pas." etroit>
  <div class="carte mx-auto my-10 flex max-w-lg flex-col items-center gap-3 p-8 text-center">
    <p class="font-heading text-5xl font-extrabold text-primary-ink">404</p>
    <h1 class="text-2xl">Page introuvable</h1>
    <p class="text-ink-muted">Cette page n'existe pas ou a été déplacée.</p>
    <div class="flex flex-wrap justify-center gap-2">
      <a href="/" class="btn btn-primaire">Accueil</a>
      <a href="/recherche/" class="btn btn-secondaire">Rechercher</a>
    </div>
  </div>
</Base>
